# Environment Variables Template
# Copy this file to .env and populate with your own credentials if needed.

# Roboflow API configuration (optional, if downloading datasets via SDK)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# PyTorch / CUDA settings
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda

# Weights & Biases / MLflow (optional experiment tracking)
WANDB_API_KEY=
MLFLOW_TRACKING_URI=
